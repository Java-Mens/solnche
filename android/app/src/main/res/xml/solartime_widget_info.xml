<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет рабочего стола «СОЛНЦЕМЕР» (ТЗ FR-24): минимально 2×1,
     желательно 4×1 (targetCellWidth), можно растягивать. Секунд нет —
     обновление раз в минуту (ТЗ FR-25). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:maxResizeWidth="320dp"
    android:maxResizeHeight="160dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/solartime_widget"
    android:description="@string/widget_description"
    android:previewLayout="@layout/solartime_widget" />
